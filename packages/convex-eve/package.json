{
  "name": "convex-eve",
  "version": "0.1.0-alpha.1",
  "description": "Convex-native persistence and reactive chat projections for eve agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dciccale/convex-eve.git",
    "directory": "packages/convex-eve"
  },
  "homepage": "https://github.com/dciccale/convex-eve#readme",
  "bugs": {
    "url": "https://github.com/dciccale/convex-eve/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "keywords": [
    "convex",
    "convex-component",
    "eve",
    "agents",
    "chat"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "import": "./dist/component/convex.config.js",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "import": "./dist/component/convex.config.js",
      "default": "./dist/component/convex.config.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "codegen": "cd ../../apps/example && convex codegen --component-dir ../../packages/convex-eve/src/component",
    "build:codegen": "bun run codegen && bun run build",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "biome check src --files-ignore-unknown=true",
    "prepare": "bun run build",
    "prepack": "bun run build",
    "prepublishOnly": "node scripts/check-publish-tag.mjs",
    "publish:next": "npm publish --tag next",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "convex-helpers": "0.1.122"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "convex": "1.43.0",
    "convex-test": "0.0.49",
    "eve": "0.31.3",
    "react": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "convex": ">=1.43.0",
    "eve": ">=0.31.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
