{
  "name": "convex-eve",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:convex": "bun run --cwd apps/example convex:dev",
    "dev:eve": "bun run --cwd apps/eve-agent dev",
    "dev:example": "bun run --cwd apps/example dev:next",
    "dev:web": "bun run --cwd apps/web dev",
    "format": "biome format --write .",
    "lint": "turbo run lint && biome check .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "changeset": "changeset",
    "release": "changeset publish",
    "verify:package": "bun scripts/verify-package.ts",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/cli": "2.31.1",
    "portless": "0.15.5",
    "turbo": "2.10.9",
    "typescript": "7.0.2"
  }
}
