{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**/*",
      "!**/.next",
      "!**/.output",
      "!**/_generated",
      "!**/dist",
      "!**/.turbo",
      "!**/.source",
      "!**/.eve",
      "!**/.vercel",
      "!**/node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "none" }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  }
}
